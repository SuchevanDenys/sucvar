# ════════════════════════════════════════════════════════════════════════════
# SUCVAR frontend (Next.js) — copy to .env.local. NO server secrets here:
# service-role key, Stripe secret/webhook secret and AI tokens live ONLY in backend/.env.
# ════════════════════════════════════════════════════════════════════════════

# Supabase Auth in the browser (public anon / publishable key — protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# .NET 10 API used by the browser (inlined at build time; also added to CSP connect-src)
NEXT_PUBLIC_API_URL=http://localhost:5080
# Optional: API address used by Server Components (e.g. http://api:8080 inside Docker).
# Falls back to NEXT_PUBLIC_API_URL. Server-only (no NEXT_PUBLIC_ prefix).
API_INTERNAL_URL=

# Public site URL (redirects / share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Admins are no longer configured here: set profiles.role = 'admin' in the database (migration 005, see /admin).

# Contact address shown on the legal pages (Terms / Privacy / Refunds)
NEXT_PUBLIC_CONTACT_EMAIL=
