{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Supabase": ""
  },
  "Supabase": {
    "Url": "",
    "JwtSecret": "",
    "Audience": "authenticated"
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": ""
  },
  "Ai": {
    "Provider": "",
    "ReplicateApiToken": "",
    "SdApiUrl": "",
    "SdApiKey": "",
    "SdMaxSide": 768,
    "SdSampler": "",
    "SdTimeoutMs": 55000,
    "SdControlNetModel": "",
    "SdControlNetModule": "",
    "DemoDelayMs": 2000,
    "GenerationBudgetSeconds": 80
  },
  "App": {
    "SiteUrl": "",
    "AllowAnonGeneration": false
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000"
  },
  "RateLimiting": {
    "GlobalPerMinute": 600
  },
  "Proxy": {
    "KnownProxies": "",
    "TrustAllForwarders": false
  }
}