<Project>
  <!--
    Shared compiler settings for every project under backend/ (src + tests).
    Individual .csproj files only declare references and project-specific items.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Nullable-reference diagnostics are bugs, not suggestions: keep the build at zero of them. -->
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Production assemblies emit their XML documentation so `/// <summary>` blocks and `cref`s are validated
    by the compiler. CS1591 (missing comment on a public member) is muted on purpose: documentation is written
    where it carries information, not on every self-explanatory DTO property.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Disk footprint: SkiaSharp's NuGet package ships native *debug symbols* (runtimes/win-*/native/libSkiaSharp.pdb,
    ~95 MB each) that were copied into every bin/ folder (~300 MB per project per configuration). They are only used
    to debug Skia's C++ code on Windows and play no part at runtime; the native libraries themselves are still copied.
  -->
  <Target Name="SucvarDropNativeSymbols" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
