# ════════════════════════════════════════════════════════════════════════════
# SUCVAR backend (.NET 10) — copy to backend/.env (loaded at startup in dev) or export
# as real environment variables. `__` = nested config key (ConnectionStrings__Supabase
# ⇔ ConnectionStrings:Supabase). The monolith's names (STRIPE_SECRET_KEY,
# REPLICATE_API_TOKEN, NEXT_PUBLIC_SUPABASE_URL, …) are also accepted as aliases.
# NEVER commit real values.
# ════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL (Supabase) ────────────────────────────────────────────────────
# Supabase Dashboard → Connect → connection string (use the `postgres` role or a dedicated
# role with access to public.*). The server connects DIRECTLY, so RLS is bypassed and every
# query filters on user_id in code. EF Core never runs migrations: apply
# supabase/migrations/001 + 002 (+ sql/billing_period.sql) from the reference project.
#
# Session pooler / direct connection (port 5432):
#   Host=aws-0-eu-central-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<db-password>;SSL Mode=Require;Trust Server Certificate=true
# Transaction pooler (port 6543, PgBouncer transaction mode) — prepared statements and
# session state are not supported there, so ALSO set:
#   ...;Port=6543;No Reset On Close=true;Max Auto Prepare=0;Pooling=true
ConnectionStrings__Supabase=Host=db.<project-ref>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<db-password>;SSL Mode=Require;Trust Server Certificate=true

# ── Supabase Auth (JWT validation) ───────────────────────────────────────────
# Project URL: tokens are validated with the project's JWKS (ES256/RS256 signing keys),
# issuer = <Url>/auth/v1, audience = authenticated.
Supabase__Url=https://<project-ref>.supabase.co
# Legacy symmetric JWT secret (HS256) — only if the project still uses the shared secret
# (Dashboard → Project Settings → JWT Keys → Legacy JWT secret). Leave empty otherwise.
Supabase__JwtSecret=

# ── Stripe ───────────────────────────────────────────────────────────────────
Stripe__SecretKey=sk_test_xxx
# `stripe listen --forward-to http://localhost:5080/api/webhooks/stripe` prints whsec_…
Stripe__WebhookSecret=whsec_xxx
# Optional fixed Price IDs (otherwise price_data is built dynamically: 29 € / 79 € per month, −20% yearly)
# STRIPE_PRICE_PRO_MONTH=
# STRIPE_PRICE_PRO_YEAR=
# STRIPE_PRICE_AGENCY_MONTH=
# STRIPE_PRICE_AGENCY_YEAR=

# ── AI image providers ───────────────────────────────────────────────────────
# stable-diffusion | replicate | demo  (empty = automatic: SD if SdApiUrl, else Replicate if token, else demo)
Ai__Provider=
Ai__ReplicateApiToken=
Ai__SdApiUrl=
Ai__SdApiKey=
Ai__SdControlNetModel=
Ai__SdControlNetModule=
Ai__SdSampler=

# ── Reverse proxy ────────────────────────────────────────────────────────────
# IPs/CIDRs of proxies allowed to set X-Forwarded-For (rate limiting uses the real client IP).
# Include the Next.js server: it forwards the visitor IP when rendering /p/[id].
# Empty = API exposed directly, forwarding headers ignored.
Proxy__KnownProxies=127.0.0.1,::1
# Max seconds for one AI call (browser aborts at 120 s).
Ai__GenerationBudgetSeconds=80

# ── App ──────────────────────────────────────────────────────────────────────
# Public URL of the Next.js frontend (Stripe success/cancel redirects).
App__SiteUrl=http://localhost:3000
# Development/demo only: allow /api/generate without a session. NEVER in production.
App__AllowAnonGeneration=false
# Comma-separated list of frontend origins allowed by CORS.
Cors__AllowedOrigins=http://localhost:3000
ASPNETCORE_URLS=http://localhost:5080
